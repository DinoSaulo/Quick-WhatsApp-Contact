{
  "manifest_version": 3,
  "name": "Quick WhatsApp Contact",
  "description": "Inicie conversas no WhatsApp a partir de números selecionados ou informados por você.",
  "version": "1.0.0",
  "homepage_url": "https://github.com/DinoSaulo/Quick-WhatsApp-Contact",
  "minimum_chrome_version": "127",
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-whatsapp-contact@dinosaulo.github.io",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["contextMenus", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'none'"
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Quick WhatsApp Contact",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "24": "icons/toolbar24.png",
      "32": "icons/toolbar32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon16.png"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
